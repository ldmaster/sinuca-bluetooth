{
  "schema_version": "1.0.0",
  "notes": "Low-poly pool cue along X: blue tip at -X, maple shaft, dark wrap, butt at +X.",
  "ops": [
    { "op": "clear" },
    { "op": "primitive", "kind": "cylinder", "name": "SM_CueTip", "size": 0.024, "location": [-0.716, 0, 0], "rotation": [0, 1.5707963, 0], "scale": [1, 1, 0.75] },
    { "op": "primitive", "kind": "cylinder", "name": "SM_CueShaft", "size": 0.024, "location": [-0.16, 0, 0], "rotation": [0, 1.5707963, 0], "scale": [1, 1, 45.0] },
    { "op": "primitive", "kind": "cylinder", "name": "SM_CueButt", "size": 0.032, "location": [0.553, 0, 0], "rotation": [0, 1.5707963, 0], "scale": [1, 1, 10.8] },
    { "op": "material", "object": "SM_CueTip", "name": "MAT_CueTip", "color": [0.05, 0.25, 0.85, 1.0], "roughness": 0.7 },
    { "op": "material", "object": "SM_CueShaft", "name": "MAT_Maple", "color": [0.78, 0.62, 0.40, 1.0], "roughness": 0.35 },
    { "op": "material", "object": "SM_CueButt", "name": "MAT_Wrap", "color": [0.10, 0.05, 0.03, 1.0], "roughness": 0.8 },
    { "op": "join", "objects": ["SM_CueTip", "SM_CueShaft", "SM_CueButt"], "name": "SM_Cue" },
    { "op": "camera", "name": "CAM-main", "location": [1.3, -1.5, 0.9], "look_at": [0, 0, 0], "lens": 50 },
    { "op": "light", "kind": "sun", "name": "LGT-key", "location": [2, -2, 4], "energy": 4.0 },
    { "op": "render", "path": "renders/preview.png", "resolution_x": 900, "resolution_y": 500, "engine": "eevee", "samples": 32, "camera": "CAM-main" },
    { "op": "export", "path": "artifacts/cue.glb", "format": "glb" },
    { "op": "save", "path": "output.blend" }
  ]
}
